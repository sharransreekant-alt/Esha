    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "firebase-tools": "^15.33.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
